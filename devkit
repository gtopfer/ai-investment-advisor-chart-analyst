def append_metric(event, **fields):
    """Append one JSON line to .ai/metrics.jsonl (best-effort)."""
    metrics_path = os.path.join(".ai", "metrics.jsonl")
    try:
        os.makedirs(".ai", exist_ok=True)
        rec = {"ts": datetime.now().isoformat(timespec="seconds"), "event": event}
        rec.update(fields)
        with open(metrics_path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except Exception:
        pass


def parse_state_table(lines):
    """Return list of dicts for data rows: idx, code, title, path, status, phase, date, raw."""
    rows = []
    for idx, line in enumerate(lines):
        if not line.strip().startswith("|"):
            continue
        if "Código" in line or re.match(r"^\s*\|\s*-+", line):
            continue
        parts = [x.strip() for x in line.split("|")[1:-1]]
        if len(parts) < 5:
            continue
        if not parts[0].startswith("SPEC-"):
            continue
        rows.append({
            "idx": idx,
            "code": parts[0],
            "title": parts[1],
            "path": parts[2],
            "status": parts[3].strip("` "),
            "phase": parts[4].strip("` "),
            "date": parts[5] if len(parts) > 5 else "",
            "raw": line,
        })
    return rows


def next_spec_number(specs_dir, state_rows=None):
    used = set()
    if os.path.isdir(specs_dir):
        for f in os.listdir(specs_dir):
            m = re.match(r"^(\d+)_", f)
            if m:
                used.add(int(m.group(1)))
    state_file = os.path.join(os.path.dirname(os.path.abspath(specs_dir)), "state.md")
    if os.path.isfile(state_file):
        try:
            with open(state_file, "r", encoding="utf-8") as fh:
                for r in parse_state_table(fh.read().splitlines()):
                    mm = re.match(r"SPEC-(\d+)", r.get("code", ""), re.I)
                    if mm:
                        used.add(int(mm.group(1)))
        except Exception:
            pass
    if state_rows:
        for r in state_rows:
            mm = re.match(r"SPEC-(\d+)", r.get("code", ""), re.I)
            if mm:
                used.add(int(mm.group(1)))
    return (max(used) + 1) if used else 1



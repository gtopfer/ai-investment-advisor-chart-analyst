def cmd_status():
    """Reads state.md and prints a beautifully aligned status table."""
    ai_dir = os.path.join(os.getcwd(), ".ai")
    state_file = os.path.join(ai_dir, "state.md")

    if not os.path.exists(state_file):
        print_err("Erro: Arquivo '.ai/state.md' não encontrado.")
        sys.exit(1)

    try:
        with open(state_file, "r", encoding="utf-8") as f:
            content = f.read()
    except Exception as e:
        print_err(f"Erro ao ler arquivo de estado: {e}")
        sys.exit(1)

    print(f"\n{BOLD}{BLUE}=== STATUS DO DESENVOLVIMENTO (Task Tracker) ==={RESET}\n")

    table_rows = []
    log_lines = []
    
    # Parse lines to separate table and logs
    in_logs = False
    for line in content.splitlines():
        if "Histórico de Execuções Recentes" in line:
            in_logs = True
            continue
        if in_logs:
            if line.strip().startswith("*"):
                log_lines.append(line.strip())
            continue

        if line.strip().startswith("|"):
            # Skip headers
            if "Código" in line or "---" in line:
                continue
            row = [x.strip() for x in line.split("|")[1:-1]]
            if len(row) >= 5:
                # Clean up values
                row[0] = row[0].strip() # Code
                row[1] = row[1].strip() # Title
                row[3] = row[3].strip("` ") # Status
                row[4] = row[4].strip("` ") # Phase
                table_rows.append(row)

    if not table_rows:
        print("Nenhuma especificação ativa cadastrada no state.md.")
    else:
        # Determine column widths
        w_code = max(len(r[0]) for r in table_rows)
        w_code = max(w_code, len("Código"))
        
        w_title = max(len(r[1]) for r in table_rows)
        w_title = max(w_title, len("Título da Spec"))
        w_title = min(w_title, 40) # cap title length
        
        w_status = max(len(r[3]) for r in table_rows)
        w_status = max(w_status, len("Status Atual"))
        
        w_phase = max(len(r[4]) for r in table_rows)
        w_phase = max(w_phase, len("Fase Ativa"))

        sep = f"+-{'-'*w_code}-+-{'-'*w_title}-+-{'-'*w_status}-+-{'-'*w_phase}-+"
        
        print(sep)
        print(f"| {BOLD}{'Código':<{w_code}}{RESET} | {BOLD}{'Título da Spec':<{w_title}}{RESET} | {BOLD}{'Status Atual':<{w_status}}{RESET} | {BOLD}{'Fase Ativa':<{w_phase}}{RESET} |")
        print(sep)
        for r in table_rows:
            code, title, path, status, phase = r[0], r[1], r[2], r[3], r[4]
            if len(title) > w_title:
                title = title[:w_title-3] + "..."
            status_color = GREEN if status == "done" else (YELLOW if status == "draft" else BLUE)
            print(f"| {code:<{w_code}} | {title:<{w_title}} | {status_color}{status:<{w_status}}{RESET} | {phase:<{w_phase}} |")
        print(sep)

    if log_lines:
        print(f"\n{BOLD}Histórico de Execuções Recentes{RESET}")
        print("-" * 30)
        for log in log_lines[:10]: # Print top 10 logs
            print(log)
    print()

def cmd_approve():
    """Transitions the active task to the next phase in state.md."""
    ai_dir = os.path.join(os.getcwd(), ".ai")
    state_file = os.path.join(ai_dir, "state.md")

    if not os.path.exists(state_file):
        print_err("Erro: Arquivo '.ai/state.md' não encontrado.")
        sys.exit(1)

    try:
        with open(state_file, "r", encoding="utf-8") as f:
            content = f.read()
    except Exception as e:
        print_err(f"Erro ao ler arquivo de estado: {e}")
        sys.exit(1)

    lines = content.splitlines()
    active_row_idx = -1
    active_row = []

    for idx, line in enumerate(lines):
        if line.strip().startswith("|") and not ("Código" in line or "---" in line):
            row = [x.strip() for x in line.split("|")[1:-1]]
            if len(row) >= 4 and row[3].strip("` ") != "done":
                active_row_idx = idx
                active_row = row
                break

    if active_row_idx == -1:
        print_info("Nenhuma especificação ativa pendente de aprovação.")
        return

    code, title, path, status, phase = active_row[0], active_row[1], active_row[2], active_row[3].strip("` "), active_row[4].strip("` ")

    # draft → PM; spec_approved → UX; ux_approved → Architect; ...
    if status not in STATE_TRANSITIONS:
        print_err(f"Erro: Status '{status}' desconhecido para a especificação {code}.")
        sys.exit(1)

    new_status, new_phase = STATE_TRANSITIONS[status]

    # Update row
    updated_row = f"| {code} | {title} | {path} | `{new_status}` | `{new_phase}` | {datetime.now().strftime('%Y-%m-%d')} |"
    lines[active_row_idx] = updated_row

    # Append to log
    log_line = f"* **{datetime.now().strftime('%Y-%m-%d')}**: [{code}] Aprovado e transicionado: `{status}` ➔ `{new_status}` (Fase Ativa: `{new_phase}`)."
    log_inserted = False
    for idx, l in enumerate(lines):
        if "Histórico de Execuções Recentes" in l:
            lines.insert(idx + 2, log_line)
            log_inserted = True
            break
    if not log_inserted:
        lines.append(log_line)

    new_state_content = "\n".join(lines) + "\n"

    try:
        with open(state_file, "w", encoding="utf-8") as f:
            f.write(new_state_content)
    except Exception as e:
        print_err(f"Erro ao atualizar arquivo de estado: {e}")
        sys.exit(1)

    print_success(f"\n{BOLD}✅ [{code}] Aprovado e Transicionado!{RESET}")
    print(f"Status: {YELLOW}`{status}` ➔ `{new_status}`{RESET}")
    print(f"Fase Ativa: {BLUE}`{new_phase}`{RESET}\n")
    append_metric("approve", code=code, from_status=status, to_status=new_status, phase=new_phase)



def _find_active_spec_row(lines):
    """Return (idx, row) of first non-done table row, or (-1, [])."""
    for idx, line in enumerate(lines):
        if line.strip().startswith("|") and not ("Código" in line or "---" in line):
            row = [x.strip() for x in line.split("|")[1:-1]]
            if len(row) >= 4 and row[3].strip("` ") != "done":
                return idx, row
    return -1, []


def _insert_state_log(lines, log_line):
    for idx, l in enumerate(lines):
        if "Histórico de Execuções Recentes" in l:
            lines.insert(idx + 2, log_line)
            return lines
    lines.append(log_line)
    return lines


def _write_state(state_file, lines):
    try:
        with open(state_file, "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
    except Exception as e:
        print_err(f"Erro ao atualizar arquivo de estado: {e}")
        sys.exit(1)


def cmd_reject():
    """Reverts the active task one step (or to test_red from QA/DoD failure stages)."""
    ai_dir = os.path.join(os.getcwd(), ".ai")
    state_file = os.path.join(ai_dir, "state.md")

    if not os.path.exists(state_file):
        print_err("Erro: Arquivo '.ai/state.md' não encontrado.")
        sys.exit(1)

    try:
        with open(state_file, "r", encoding="utf-8") as f:
            content = f.read()
    except Exception as e:
        print_err(f"Erro ao ler arquivo de estado: {e}")
        sys.exit(1)

    lines = content.splitlines()
    active_row_idx, active_row = _find_active_spec_row(lines)

    if active_row_idx == -1:
        print_info("Nenhuma especificação ativa para rejeitar.")
        return

    code, title, path = active_row[0], active_row[1], active_row[2]
    status = active_row[3].strip("` ")
    phase = active_row[4].strip("` ") if len(active_row) > 4 else ""

    # Retrocesso alinhado ao squad-lead:
    # - code_review / tested ➔ test_red (devolução ao Developer)
    # - demais status ➔ um passo anterior no fluxo feliz
    if status not in REJECT_TRANSITIONS:
        print_err(f"Erro: Status '{status}' desconhecido para a especificação {code}.")
        sys.exit(1)

    target = REJECT_TRANSITIONS[status]
    if target is None:
        print_info(f"[{code}] já está em `draft` — não há fase anterior para rejeitar.")
        return

    new_status, new_phase = target
    updated_row = (
        f"| {code} | {title} | {path} | `{new_status}` | `{new_phase}` | "
        f"{datetime.now().strftime('%Y-%m-%d')} |"
    )
    lines[active_row_idx] = updated_row
    log_line = (
        f"* **{datetime.now().strftime('%Y-%m-%d')}**: [{code}] Rejeitado e retrocedido: "
        f"`{status}` ➔ `{new_status}` (Fase Ativa: `{new_phase}`)."
    )
    lines = _insert_state_log(lines, log_line)
    _write_state(state_file, lines)

    print_success(f"\n{BOLD}↩ [{code}] Rejeitado e Retrocedido!{RESET}")
    print(f"Status: {YELLOW}`{status}` ➔ `{new_status}`{RESET}")
    print(f"Fase Ativa: {BLUE}`{new_phase}`{RESET}\n")
    append_metric("reject", code=code, from_status=status, to_status=new_status, phase=new_phase)



def normalize_repo_path(path):
    """Normalize a repo-relative path from state.md (handles backticks; never lstrip './')."""
    p = path.strip().strip("`").strip().replace("\\", "/")
    if p.startswith("./"):
        p = p[2:]
    return p


def cmd_sync(argv=None):
    """Registers orphan specs from .ai/specs/ into state.md; reports missing files.

    Flags:
      --migrate-lifecycle  Corrige fases legadas (ex.: spec_approved+architect → ux)
    """
    if argv is None:
        argv = sys.argv[2:]
    do_migrate = "--migrate-lifecycle" in argv

    ai_dir = os.path.join(os.getcwd(), ".ai")
    specs_dir = os.path.join(ai_dir, "specs")
    state_file = os.path.join(ai_dir, "state.md")

    if not os.path.exists(ai_dir) or not os.path.exists(state_file):
        print_err("Erro: Diretório '.ai' ou '.ai/state.md' não encontrado.")
        sys.exit(1)

    os.makedirs(specs_dir, exist_ok=True)

    try:
        with open(state_file, "r", encoding="utf-8") as f:
            content = f.read()
    except Exception as e:
        print_err(f"Erro ao ler arquivo de estado: {e}")
        sys.exit(1)

    lines = content.splitlines()

    migrated = []
    if do_migrate:
        today = datetime.now().strftime("%Y-%m-%d")
        for row in parse_state_table(lines):
            status, phase = row["status"], row["phase"]
            expected = STATUS_TO_PHASE.get(status)
            # legado: spec_approved com phase architect (pré-UX)
            if status == "spec_approved" and phase == "architect":
                expected = "ux"
            if expected and phase != expected and status != "done":
                new_line = (
                    f"| {row['code']} | {row['title']} | {row['path']} | "
                    f"`{status}` | `{expected}` | {today} |"
                )
                lines[row["idx"]] = new_line
                migrated.append((row["code"], phase, expected, status))
        if migrated:
            log_line = (
                f"* **{today}**: Migração de lifecycle: "
                + ", ".join(f"{c} phase `{a}`→`{b}`" for c, a, b, _ in migrated)
                + "."
            )
            lines = _insert_state_log(lines, log_line)
            _write_state(state_file, lines)
            # re-read
            with open(state_file, "r", encoding="utf-8") as f:
                lines = f.read().splitlines()

    # Paths already registered in state.md
    registered_paths = set()
    registered_codes = set()
    state_rows = []  # (idx, row)
    for idx, line in enumerate(lines):
        if line.strip().startswith("|") and not ("Código" in line or "---" in line):
            row = [x.strip() for x in line.split("|")[1:-1]]
            if len(row) >= 3:
                state_rows.append((idx, row))
                path_clean = normalize_repo_path(row[2])
                registered_paths.add(path_clean)
                registered_codes.add(row[0].strip())

    # Spec files on disk
    disk_files = []
    for name in sorted(os.listdir(specs_dir)):
        if not name.endswith(".md") or name == "README.md":
            continue
        rel = f".ai/specs/{name}"
        disk_files.append((name, rel, os.path.join(specs_dir, name)))

    disk_paths = {rel for _, rel, _ in disk_files}

    # Orphan state rows (path missing on disk)
    orphans = []
    for idx, row in state_rows:
        path_clean = normalize_repo_path(row[2])
        if path_clean not in disk_paths and not os.path.exists(path_clean):
            orphans.append((row[0], path_clean))

    # New files not in state
    added = []
    today = datetime.now().strftime("%Y-%m-%d")

    # Determine next SPEC number from disk + state
    used_nums = set()
    for name, rel, _ in disk_files:
        m = re.match(r"^(\d+)_", name)
        if m:
            used_nums.add(int(m.group(1)))
    for code in registered_codes:
        m = re.match(r"SPEC-(\d+)", code, re.I)
        if m:
            used_nums.add(int(m.group(1)))

    for name, rel, full in disk_files:
        if rel in registered_paths:
            continue
        # Title from first H1 or filename
        title = get_slug(name).replace("_", " ").title()
        try:
            with open(full, "r", encoding="utf-8") as sf:
                for line in sf:
                    if line.startswith("# "):
                        title = line[2:].strip()
                        # strip common prefix
                        for prefix in ("Especificação de Feature:", "Especificação:", "Feature:"):
                            if title.lower().startswith(prefix.lower()):
                                title = title[len(prefix):].strip()
                        break
        except Exception:
            pass

        m = re.match(r"^(\d+)_", name)
        if m:
            num = int(m.group(1))
            spec_code = f"SPEC-{num:03d}"
        else:
            num = (max(used_nums) + 1) if used_nums else 1
            while num in used_nums:
                num += 1
            used_nums.add(num)
            spec_code = f"SPEC-{num:03d}"

        if spec_code in registered_codes:
            # collision: bump
            num = (max(used_nums) + 1) if used_nums else 1
            while num in used_nums or f"SPEC-{num:03d}" in registered_codes:
                num += 1
            used_nums.add(num)
            spec_code = f"SPEC-{num:03d}"

        new_row = f"| {spec_code} | {title} | `{rel}` | `draft` | `pm` | {today} |"

        # Insert after last table row or after separator
        table_idx = -1
        for idx, l in enumerate(lines):
            if l.strip().startswith("|") and "SPEC-" in l:
                table_idx = idx
        if table_idx == -1:
            for idx, l in enumerate(lines):
                if l.strip().startswith("|") and "---" in l:
                    table_idx = idx
                    break
        if table_idx != -1:
            lines.insert(table_idx + 1, new_row)
        else:
            lines.append(new_row)

        registered_paths.add(rel)
        registered_codes.add(spec_code)
        used_nums.add(num)
        added.append((spec_code, title, rel))

        log_line = (
            f"* **{today}**: Sync registrou `{rel}` como `{spec_code}` "
            f"(status `draft`, fase `pm`)."
        )
        lines = _insert_state_log(lines, log_line)

    if added:
        _write_state(state_file, lines)

    print(f"\n{BOLD}{BLUE}=== SYNC .ai/specs/ ↔ state.md ==={RESET}\n")
    if added:
        print_success(f"Registradas {len(added)} especificação(ões) nova(s):")
        for code, title, rel in added:
            print(f"  + {code} — {title} ({rel}) → `draft` / `pm`")
    else:
        print_info("Nenhuma spec órfã em disco — state.md já cobre todos os arquivos.")

    if orphans:
        print(f"\n{YELLOW}Aviso: {len(orphans)} linha(s) no state.md sem arquivo correspondente:{RESET}")
        for code, path in orphans:
            print(f"  ! {code} → {path} (arquivo ausente)")
        print(f"{YELLOW}Remova a linha manualmente ou restaure o arquivo.{RESET}")
    else:
        print_info("Nenhuma linha órfã no state.md.")

    if migrated:
        print_success(f"Lifecycle migrado em {len(migrated)} linha(s):")
        for code, old_p, new_p, status in migrated:
            print(f"  ~ {code} [{status}] fase `{old_p}` → `{new_p}`")
        print()

    print()
    if not added and not orphans and not migrated:
        print_success("State e specs estão sincronizados.\n")
    elif not added and not orphans and migrated:
        print_success("Specs ok; fases alinhadas ao lifecycle atual.\n")


# Extensões tratadas como código-fonte na varredura de TODO/FIXME
CODE_EXTS = {
    ".py", ".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs",
    ".go", ".rs", ".java", ".kt", ".cpp", ".cc", ".c", ".h", ".hpp",
    ".cs", ".php", ".rb", ".swift", ".scala", ".vue", ".svelte",
}

# Marcadores de trabalho incompleto em comentários (não documentação que cita a regra)
TODO_COMMENT_PATTERN = re.compile(
    r"(?://|#|/\*|\*)\s*(TODO|FIXME)\b"
    r"|//\s*(o resto do código|resto do|rest of the code)",
    re.IGNORECASE,
)


def is_code_file(path):
    """True for source files (inclui o script `devkit` sem extensão)."""
    base = os.path.basename(path)
    if base == "devkit":
        return True
    return os.path.splitext(base)[1].lower() in CODE_EXTS


def check_todos_in_files(files):
    """Scans code files for incomplete-work comment markers (TODO, FIXME, placeholders)."""
    violations = []

    for f in files:
        if not os.path.exists(f) or os.path.isdir(f):
            continue
        if not is_code_file(f):
            continue
        try:
            with open(f, "r", encoding="utf-8", errors="ignore") as fh:
                for line_num, line in enumerate(fh, 1):
                    if TODO_COMMENT_PATTERN.search(line):
                        violations.append((f, line_num, line.strip()))
        except Exception:
            pass
    return violations

def get_modified_files():
    """Identifies modified files in git, or falls back to scan workspace directory."""
    files = []
    if os.path.exists(".git"):
        try:
            out = subprocess.check_output(["git", "status", "--porcelain"], stderr=subprocess.DEVNULL)
            for line in out.decode("utf-8").splitlines():
                if len(line) > 3:
                    file_path = line[3:].strip()
                    if line[0] != 'D' and os.path.exists(file_path):
                        files.append(file_path)
            return files
        except Exception:
            pass

    # Fallback scan
    skip_folders = {".git", "node_modules", "__pycache__", ".ai", "docs", "venv", ".venv", "dist", "build"}
    for root, dirs, filenames in os.walk("."):
        dirs[:] = [d for d in dirs if d not in skip_folders]
        for f in filenames:
            ext = os.path.splitext(f)[1]
            if ext in (".py", ".js", ".ts", ".tsx", ".go", ".rs", ".java", ".cpp", ".c", ".h", ".cs", ".php", ".css", ".html"):
                files.append(os.path.relpath(os.path.join(root, f), "."))
    return files

def is_python_project():
    """Detect Python projects including the DevKit CLI (shebang script without .py)."""
    if os.path.exists("requirements.txt") or os.path.exists("pyproject.toml") or os.path.exists("setup.py"):
        return True
    try:
        if any(f.endswith(".py") for f in os.listdir(".")):
            return True
    except OSError:
        pass
    if os.path.isfile("devkit"):
        try:
            with open("devkit", "r", encoding="utf-8", errors="ignore") as fh:
                first = fh.readline()
            if "python" in first.lower():
                return True
        except OSError:
            pass
    return False



def check_ui_heuristics(files):
    """Heuristic UI checks on modified frontend-ish files. Returns (warnings, hard_violations)."""
    warnings = []
    hard = []
    ui_files = []
    for f in files:
        if not os.path.exists(f) or os.path.isdir(f):
            continue
        ext = os.path.splitext(f)[1].lower()
        base = os.path.basename(f).lower()
        if ext in UI_EXTS or ext in {".tsx", ".jsx", ".vue", ".svelte"} or base.endswith(".module.css"):
            ui_files.append(f)

    if not ui_files:
        return warnings, hard

    # Active spec mentions UI?
    has_ui_spec = False
    try:
        state_file = os.path.join(".ai", "state.md")
        if os.path.exists(state_file):
            with open(state_file, "r", encoding="utf-8") as fh:
                rows = parse_state_table(fh.read().splitlines())
            for r in rows:
                if r["status"] == "done":
                    continue
                p = normalize_repo_path(r["path"])
                if os.path.exists(p):
                    with open(p, "r", encoding="utf-8", errors="ignore") as sf:
                        body = sf.read().lower()
                    if "há interface de usuário? sim" in body or "interface de usuário? sim" in body:
                        has_ui_spec = True
                    if "n/a" in body and "interface" in body:
                        has_ui_spec = False
    except Exception:
        pass

    joined_content = []
    for f in ui_files:
        try:
            with open(f, "r", encoding="utf-8", errors="ignore") as fh:
                content = fh.read()
            joined_content.append(content)
            for line_num, line in enumerate(content.splitlines(), 1):
                if HEX_COLOR_PATTERN.search(line) and "var(" not in line and "token" not in line.lower():
                    # allow in .css variables definitions sometimes — still warn
                    warnings.append((f, line_num, "cor hex solta (prefira tokens do design system)", line.strip()[:120]))
                if RAW_RGB_PATTERN.search(line) and "var(" not in line:
                    warnings.append((f, line_num, "rgb/hsl cru (prefira tokens)", line.strip()[:120]))
        except Exception:
            pass

    blob = "\n".join(joined_content).lower()
    # State coverage hints when UI files changed and spec says UI
    if has_ui_spec or ui_files:
        for token, label in [
            ("loading", "loading/skeleton"),
            ("empty", "empty state"),
            ("error", "error/retry"),
            ("disabled", "disabled/submitting"),
            ("aria-", "aria/a11y"),
        ]:
            if token not in blob and label not in blob:
                warnings.append(("-", 0, f"diff UI sem indício de '{label}' (verifique skill ui-ux)", ""))

    return warnings, hard


def cmd_review():
    """Detects stack, runs linter, checks types, executes tests, scans for TODOs and formats output."""
    print_info("Iniciando Validação e Code Review...\n")
    
    modified_files = get_modified_files()
    todo_violations = check_todos_in_files(modified_files)
    ui_warnings, ui_hard = check_ui_heuristics(modified_files)

    stack = "unknown"
    lint_cmd = None
    type_cmd = None
    test_cmd = None

    if os.path.exists("package.json"):
        stack = "Node.js (JS/TS)"
        try:
            with open("package.json", "r", encoding="utf-8") as pf:
                pj = pf.read()
            if '"lint"' in pj:
                lint_cmd = ["npm", "run", "lint"]
            if '"typecheck"' in pj:
                type_cmd = ["npm", "run", "typecheck"]
            elif os.path.exists("tsconfig.json"):
                type_cmd = ["npx", "tsc", "--noEmit"]
            if '"test"' in pj:
                test_cmd = ["npm", "test"]
        except Exception:
            pass
    elif is_python_project():
        stack = "Python"
        # App packages + root modules + tests. Do NOT lint the DevKit CLI script
        # (./devkit) as application production code — ruff.toml also excludes it.
        lint_targets = []
        app_dirs = (
            "analysis", "allocator", "ui", "llm", "portfolio", "config",
            "data_fetcher", "models", "utils", "tests",
        )
        try:
            for name in os.listdir("."):
                if name.endswith(".py"):
                    lint_targets.append(name)
            for d in app_dirs:
                if not os.path.isdir(d):
                    continue
                for root, _, files in os.walk(d):
                    if "__pycache__" in root.split(os.sep):
                        continue
                    for f in files:
                        if f.endswith(".py"):
                            lint_targets.append(os.path.join(root, f))
        except OSError:
            pass
        if shutil.which("ruff") and lint_targets:
            lint_cmd = ["ruff", "check"] + lint_targets
        elif shutil.which("flake8") and lint_targets:
            lint_cmd = ["flake8"] + lint_targets
        elif lint_targets:
            # Fallback: validação de sintaxe sem dependências externas
            lint_cmd = [sys.executable, "-m", "py_compile"] + lint_targets
        if shutil.which("mypy") and (os.path.exists("pyproject.toml") or os.path.exists("mypy.ini")):
            type_cmd = ["mypy", "."]
        if os.path.isdir("tests"):
            # Prefer the same interpreter running the CLI (venv when activated)
            test_cmd = [sys.executable, "-m", "pytest", "-q"]
        elif shutil.which("pytest"):
            test_cmd = [sys.executable, "-m", "pytest", "-q"]
    elif os.path.exists("Cargo.toml"):
        stack = "Rust"
        lint_cmd = ["cargo", "clippy"]
        type_cmd = ["cargo", "check"]
        test_cmd = ["cargo", "test"]
    elif os.path.exists("go.mod"):
        stack = "Go"
        type_cmd = ["go", "vet"]
        test_cmd = ["go", "test", "./..."]

    print_info(f"Stack Detectada: {BOLD}{stack}{RESET}")

    lint_success = True
    lint_out = ""
    if lint_cmd:
        print_info(f"Executando Linter: {' '.join(lint_cmd)}...")
        res = subprocess.run(lint_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        lint_success = (res.returncode == 0)
        lint_out = (res.stdout + res.stderr).decode("utf-8")

    type_success = True
    type_out = ""
    if type_cmd:
        print_info(f"Executando Typecheck/Build: {' '.join(type_cmd)}...")
        res = subprocess.run(type_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        type_success = (res.returncode == 0)
        type_out = (res.stdout + res.stderr).decode("utf-8")

    test_success = True
    test_out = ""
    if test_cmd:
        print_info(f"Executando Testes: {' '.join(test_cmd)}...")
        res = subprocess.run(test_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        test_success = (res.returncode == 0)
        test_out = (res.stdout + res.stderr).decode("utf-8")

    passed = (not todo_violations) and lint_success and type_success and test_success

    report = []
    report.append(f"# Code Review — {f'{GREEN}{BOLD}APROVADO{RESET}' if passed else f'{RED}{BOLD}REPROVADO{RESET}'}")
    report.append(f"**Stack Identificada**: {stack}")
    report.append(f"**Data da Execução**: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    report.append("\n## Checklists de Validação")

    if todo_violations:
        report.append(f"- ❌ **Marcadores TODO/FIXME/Placeholders**: {len(todo_violations)} encontrado(s)")
        for f, line, text in todo_violations:
            report.append(f"  - `{f}:{line}` ➔ `{text}`")
    else:
        report.append("- ✅ **Marcadores TODO/FIXME/Placeholders**: Nenhum encontrado")

    if lint_cmd:
        status_icon = "✅" if lint_success else "❌"
        report.append(f"- {status_icon} **Linter**: {f'OK' if lint_success else 'Falhou'}")
        if not lint_success:
            report.append("```\n" + lint_out[:500] + ("\n... [truncado]" if len(lint_out) > 500 else "") + "\n```")
    else:
        report.append("- ⚠️ **Linter**: Nenhum linter configurado/detectado")

    if type_cmd:
        status_icon = "✅" if type_success else "❌"
        report.append(f"- {status_icon} **Build / Typecheck**: {f'OK' if type_success else 'Falhou'}")
        if not type_success:
            report.append("```\n" + type_out[:500] + ("\n... [truncado]" if len(type_out) > 500 else "") + "\n```")
    else:
        report.append("- ⚠️ **Build / Typecheck**: Nenhuma verificação de tipo configurada")

    if test_cmd:
        status_icon = "✅" if test_success else "❌"
        report.append(f"- {status_icon} **Suíte de Testes**: {f'Passou' if test_success else 'Falhou'}")
        if not test_success:
            report.append("```\n" + test_out[:500] + ("\n... [truncado]" if len(test_out) > 500 else "") + "\n```")
    else:
        report.append("- ⚠️ **Suíte de Testes**: Nenhuma suíte de testes detectada")

    if ui_hard:
        report.append(f"- ❌ **UI heuristics**: {len(ui_hard)} violação(ões)")
        for item in ui_hard[:20]:
            report.append(f"  - {item}")
        passed = False
    elif ui_warnings:
        report.append(f"- ⚠️ **UI heuristics**: {len(ui_warnings)} aviso(s) (não bloqueante)")
        for f, line, msg, snippet in ui_warnings[:15]:
            loc = f"`{f}:{line}`" if line else "`(diff)`"
            report.append(f"  - {loc} ➔ {msg}")
    else:
        report.append("- ✅ **UI heuristics**: Sem avisos (ou sem arquivos de UI no diff)")

    print("\n" + "=" * 50)
    print("\n".join(report))
    print("=" * 50 + "\n")

    sys.exit(0 if passed else 1)


def cmd_doctor():
    """Validate DevKit integrity in the current project."""
    print(f"\n{BOLD}{BLUE}=== DEVKIT DOCTOR ==={RESET}\n")
    errors = []
    warnings = []

    if not os.path.isdir(".ai"):
        errors.append("Diretório .ai/ ausente — rode ./devkit init")
    for rel in REQUIRED_AI_FILES:
        if not os.path.exists(rel):
            errors.append(f"Ausente: {rel}")

    if not os.path.isfile("devkit") and not os.path.isfile("./devkit"):
        warnings.append("Executável ./devkit não encontrado na raiz (ok se a CLI está só no PATH)")

    # state vs specs
    state_file = os.path.join(".ai", "state.md")
    if os.path.exists(state_file):
        with open(state_file, "r", encoding="utf-8") as f:
            lines = f.read().splitlines()
        rows = parse_state_table(lines)
        if not rows:
            warnings.append("state.md sem linhas SPEC-")
        for r in rows:
            p = normalize_repo_path(r["path"])
            if not os.path.exists(p):
                errors.append(f"{r['code']}: arquivo ausente {p}")
            expected = STATUS_TO_PHASE.get(r["status"])
            if r["status"] == "spec_approved" and r["phase"] == "architect":
                warnings.append(
                    f"{r['code']}: fase legada `architect` em spec_approved — rode ./devkit sync --migrate-lifecycle"
                )
            elif expected and r["phase"] != expected and r["status"] != "done":
                warnings.append(
                    f"{r['code']}: fase `{r['phase']}` ≠ esperada `{expected}` para status `{r['status']}`"
                )
            if r["status"] not in STATUS_TO_PHASE:
                errors.append(f"{r['code']}: status desconhecido `{r['status']}`")

    # python syntax of CLI if present
    if os.path.isfile("devkit"):
        res = subprocess.run(
            [sys.executable, "-m", "py_compile", "devkit"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if res.returncode != 0:
            errors.append("devkit falhou em py_compile")
        else:
            print_success("✓ CLI devkit: sintaxe OK")

    print_info(f"Arquivos obrigatórios checados: {len(REQUIRED_AI_FILES)}")
    if warnings:
        print(f"\n{YELLOW}Avisos ({len(warnings)}):{RESET}")
        for w in warnings:
            print(f"  ! {w}")
    if errors:
        print(f"\n{RED}Erros ({len(errors)}):{RESET}")
        for e in errors:
            print(f"  ✗ {e}")
        print()
        sys.exit(1)

    print_success("\nDoctor: APROVADO — estrutura DevKit íntegra.\n")
    print_info("Próximo passo humano: leia docs/GUIA-DO-USUARIO.md (jornada contínua).")

    append_metric("doctor", ok=True)


def cmd_log(argv=None):
    """Show recent state history and metrics."""
    if argv is None:
        argv = sys.argv[2:]
    limit = 20
    if "--all" in argv:
        limit = 1000
    for i, a in enumerate(argv):
        if a == "--limit" and i + 1 < len(argv):
            try:
                limit = int(argv[i + 1])
            except ValueError:
                pass

    print(f"\n{BOLD}{BLUE}=== DEVKIT LOG ==={RESET}\n")
    state_file = os.path.join(".ai", "state.md")
    if os.path.exists(state_file):
        with open(state_file, "r", encoding="utf-8") as f:
            content = f.read()
        logs = []
        in_logs = False
        for line in content.splitlines():
            if "Histórico de Execuções Recentes" in line:
                in_logs = True
                continue
            if in_logs and line.strip().startswith("*"):
                logs.append(line.strip())
        print(f"{BOLD}State history{RESET} (top {min(limit, len(logs))})")
        for line in logs[:limit]:
            print(line)
    else:
        print_err("state.md não encontrado")

    metrics = os.path.join(".ai", "metrics.jsonl")
    if os.path.exists(metrics):
        print(f"\n{BOLD}Metrics{RESET} (.ai/metrics.jsonl)")
        with open(metrics, "r", encoding="utf-8") as f:
            lines = f.read().splitlines()
        for line in lines[-limit:]:
            print(f"  {line}")
        # simple counts
        counts = {}
        for line in lines:
            try:
                ev = json.loads(line).get("event", "?")
                counts[ev] = counts.get(ev, 0) + 1
            except Exception:
                pass
        if counts:
            print(f"\n{BOLD}Contagem de eventos{RESET}")
            for k, v in sorted(counts.items(), key=lambda x: -x[1]):
                print(f"  {k}: {v}")
    else:
        print_info("\nSem .ai/metrics.jsonl ainda (gerado por approve/reject/propose/…).")
    print()


def cmd_activate(argv=None):
    """Make a SPEC the first active (non-done) row so approve targets it."""
    if argv is None:
        argv = sys.argv[2:]
    if not argv or argv[0].startswith("-"):
        print_err("Uso: ./devkit activate SPEC-00N")
        sys.exit(1)
    code = argv[0].upper()
    if not code.startswith("SPEC-"):
        code = f"SPEC-{code}" if code.isdigit() else code

    state_file = os.path.join(".ai", "state.md")
    if not os.path.exists(state_file):
        print_err("state.md não encontrado")
        sys.exit(1)
    with open(state_file, "r", encoding="utf-8") as f:
        lines = f.read().splitlines()
    rows = parse_state_table(lines)
    target = None
    for r in rows:
        if r["code"].upper() == code:
            target = r
            break
    if not target:
        print_err(f"Especificação {code} não encontrada no state.md")
        sys.exit(1)
    if target["status"] == "done":
        print_err(f"{code} já está done — não pode ativar.")
        sys.exit(1)

    # Remove line and reinsert after header separator (first data position among non-done priority)
    line = lines[target["idx"]]
    del lines[target["idx"]]
    # Find insertion point: after last header '---' of the table, before other SPEC rows — put at top of table body
    insert_at = None
    for idx, l in enumerate(lines):
        if l.strip().startswith("|") and "---" in l and "Código" not in l:
            # next lines are body; we want first position of body
            insert_at = idx + 1
            break
    if insert_at is None:
        insert_at = len(lines)
    lines.insert(insert_at, line)
    today = datetime.now().strftime("%Y-%m-%d")
    lines = _insert_state_log(
        lines,
        f"* **{today}**: [{code}] ativada como spec prioritária (topo da fila ativa).",
    )
    _write_state(state_file, lines)
    append_metric("activate", code=code)
    print_success(f"\n✅ {code} agora é a primeira spec na fila do approve/reject.\n")


def cmd_hotfix(argv=None):
    """Create a hotfix spec that starts at tech_approved (skips PM polish, UX, Architect).

    Requires --title. Optional --reason.
    Still requires QA TDD → Developer → review → DoD with audit note.
    """
    if argv is None:
        argv = sys.argv[2:]
    title = reason = None
    i = 0
    while i < len(argv):
        if argv[i] == "--title" and i + 1 < len(argv):
            title = argv[i + 1]; i += 2; continue
        if argv[i] == "--reason" and i + 1 < len(argv):
            reason = argv[i + 1]; i += 2; continue
        print_err(f"Uso: ./devkit hotfix --title TEXT [--reason TEXT]")
        sys.exit(1)
    if not title:
        print_err("Uso: ./devkit hotfix --title TEXT [--reason TEXT]")
        sys.exit(1)

    ai_dir = os.path.join(os.getcwd(), ".ai")
    specs_dir = os.path.join(ai_dir, "specs")
    state_file = os.path.join(ai_dir, "state.md")
    if not os.path.exists(state_file):
        print_err("Projeto sem .ai/state.md — rode ./devkit init")
        sys.exit(1)
    os.makedirs(specs_dir, exist_ok=True)

    full_title = f"[HOTFIX] {title}"
    next_num = next_spec_number(specs_dir)
    seq_str = f"{next_num:03d}"
    spec_code = f"SPEC-{seq_str}"
    filename = f"{seq_str}_{get_slug(title)}.md"
    reason = reason or "Não informado"
    extra = f"""
## 0. HOTFIX — Auditoria de gates pulados
- **Motivo**: {reason}
- **Gates pulados**: detalhamento PM estendido, fase UX, fase Architect
- **Obrigatório no DoD**: registrar no CHANGELOG o que foi pulado e risco residual
- **UI**: N/A por padrão em hotfix (se houver UI, volte com reject para UX ou abra feature normal)

## 3. Expectativas de UI/UX (se aplicável)
- Há interface de usuário? Não (hotfix) — se for UI, não use hotfix
"""
    content = build_spec_markdown(
        full_title,
        "operador / time",
        f"corrigir: {title}",
        "restaurar serviço ou eliminar regressão crítica",
        [f"Corrigir: {title}", f"Motivo: {reason}"],
        extra_sections=extra,
    )
    # Force UI N/A and mark DoR partially
    filepath = os.path.join(specs_dir, filename)
    with open(filepath, "w", encoding="utf-8") as f:
        f.write(content)

    # Start at tech_approved so QA still writes/reds tests
    register_spec_in_state(state_file, spec_code, full_title, filename, "tech_approved", "qa_tdd")
    append_metric("hotfix", code=spec_code, title=title, reason=reason)

    print_success(f"\n{BOLD}🚨 HOTFIX {spec_code} criado{RESET}")
    print(f"Arquivo: .ai/specs/{filename}")
    print(f"Status inicial: {YELLOW}tech_approved{RESET} / fase {BLUE}qa_tdd{RESET}")
    print("Gates pulados: PM estendido, UX, Architect.")
    print("Próximo: QA (TDD) → Developer → review → PM DoD com auditoria no CHANGELOG.\n")


def print_help():
    print(f"""{BOLD}Uso:{RESET} ./devkit <comando> [argumentos]

{BOLD}Comandos disponíveis:{RESET}
  {BLUE}init [diretório]{RESET}     Inicializa o devkit no alvo (com sanitização)
  {BLUE}propose [flags]{RESET}      Nova spec (wizard ou --title/--persona/--want/--so-that/--req)
  {BLUE}hotfix --title T{RESET}     Spec de emergência em tech_approved (pula PM/UX/Arch)
  {BLUE}status{RESET}               Painel de specs e fases
  {BLUE}sync [--migrate-lifecycle]{RESET}  Specs órfãs + migração de fases legadas
  {BLUE}activate SPEC-N{RESET}      Prioriza spec na fila do approve
  {BLUE}approve{RESET}              Avança a spec ativa
  {BLUE}reject{RESET}               Retrocede a spec ativa
  {BLUE}review{RESET}               Lint, types, testes, TODO, heurísticas UI
  {BLUE}doctor{RESET}               Valida integridade do kit no projeto
  {BLUE}log [--limit N]{RESET}      Histórico do state + metrics.jsonl
  {BLUE}help{RESET}                 Esta mensagem

Guia didático: docs/GUIA-DO-USUARIO.md
""")


def main():
    if len(sys.argv) < 2:
        print_help()
        sys.exit(1)

    command = sys.argv[1].lower()
    rest = sys.argv[2:]

    if command == "init":
        target = rest[0] if rest else None
        cmd_init(target)
    elif command == "propose":
        cmd_propose(rest)
    elif command == "hotfix":
        cmd_hotfix(rest)
    elif command == "status":
        cmd_status()
    elif command == "sync":
        cmd_sync(rest)
    elif command == "activate":
        cmd_activate(rest)
    elif command == "approve":
        cmd_approve()
    elif command == "reject":
        cmd_reject()
    elif command == "review":
        cmd_review()
    elif command == "doctor":
        cmd_doctor()
    elif command == "log":
        cmd_log(rest)
    elif command in ("help", "--help", "-h"):
        print_help()
    else:
        print_err(f"Erro: Comando desconhecido '{command}'")
        print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()

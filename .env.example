# Chave de API da Groq Cloud (opcional). Gratuita em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI-compatible (Ollama, OpenRouter, LM Studio, API OpenAI, etc.)
# Ex. Ollama local: OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Preferência de provedor quando ambos estão configurados: groq | openai_compatible
LLM_PROVIDER=

# Senha opcional para liberar o botão de análise IA na interface.
AI_ACCESS_PASSWORD=

# Limite de chamadas à IA por sessão de usuário.
MAX_AI_CALLS_PER_SESSION=15

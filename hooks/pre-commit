#!/usr/bin/env bash
# Hook opcional: rode ./devkit review nos arquivos staged.
# Instalação: cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
if [[ -x "./devkit" ]]; then
  ./devkit review
elif command -v python3 >/dev/null 2>&1; then
  python3 ./devkit review
else
  echo "devkit/python3 não encontrado" >&2
  exit 1
fi
